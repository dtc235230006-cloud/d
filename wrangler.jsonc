{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "education-spatial-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "containers": [
    {
      "class_name": "FlaskAppContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEB_APP",
        "class_name": "FlaskAppContainer"
      }
    ]
  },
  "exports": {
    "FlaskAppContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
